# Application
APP_ENV=prod
APP_DEBUG=false
APP_COOKIE_VALIDATION_KEY=replace-with-at-least-32-random-characters

# Database
DB_DSN=mysql:host=127.0.0.1;dbname=sistema_inversiones
DB_USERNAME=sistema_inversiones_app
DB_PASSWORD=replace-with-a-strong-password

# Institutional email
MAILER_DSN=smtp://username:password@smtp.example.gob.ec:587
ADMIN_EMAIL=inversiones@example.gob.ec
SENDER_EMAIL=no-reply@example.gob.ec
SENDER_NAME=Ventanilla de Inversiones

# Data lifecycle
DOCUMENT_RETENTION_DAYS=1825
MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
